      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "Finance Dashboard",
      "short_name": "Finance",
      "description": "View financial reports and insights",
      "url": "/finance",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    },
    {
      "name": "ML Engine",
      "short_name": "ML",
      "description": "Train machine learning models",
      "url": "/ml-engine",
      "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/analyze",
    "method": "POST",
    "enctype": "multipart/form-data",
